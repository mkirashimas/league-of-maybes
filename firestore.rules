rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny by default: only the paths matched below are accessible.

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Everything a user stores lives under users/{uid}: the user doc itself
    // (consent) and all collections (players, traitDefinitions, intel, chat*, dates,
    // dateSummaries, agendaItems, keyNotes, settings, devices). Owner only.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
